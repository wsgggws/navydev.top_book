[Unit]
Description=navydev.top/book — Lector EPUB reader and audiobook player
After=network.target

[Service]
Type=simple
User=lector
Group=lector
WorkingDirectory=/opt/navydev.top_book/current
Environment=LECTOR_DATA_DIR=/var/lib/lector
Environment=LECTOR_HOST=127.0.0.1
Environment=LECTOR_PORT=8010
Environment=LECTOR_BASE_PATH=/book
# 令牌建议放到一个 600 权限的文件里，用 EnvironmentFile= 读。
EnvironmentFile=-/etc/lector/env
ExecStart=/opt/navydev.top_book/current/.venv/bin/lector-server
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lector

[Install]
WantedBy=multi-user.target
